# ============================================================
# Pharmacy Accounting App — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Firebase (client-safe keys — safe to expose) ---
# Your project: gen-lang-client-0235233930
# Web app ID: 1:626737820080:web:your-web-app-id
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0235233930
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0235233930
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0235233930.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=626737820080
VITE_FIREBASE_APP_ID=1:626737820080:web:your-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=1234567890:AAYourBotTokenHere

# --- Google Service Account (Gmail + Drive backups) ---
# Path to the downloaded service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Email of the service account (must share the Drive folder & allow Gmail send)
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# Recipient for the daily backup report email
OWNER_GMAIL=owner@gmail.com
# Google Drive folder ID where backups are uploaded
DRIVE_FOLDER_ID=1abcDEFghiJKLmnopQRstuVwxyz

# --- App / Backup settings ---
APP_NAME=Pharmacy Daily Accounting
DEFAULT_PIN=1234
BACKUP_TIME_BDT=23:55